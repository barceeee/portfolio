{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/projects/:slug", "destination": "/project" },
    { "source": "/demos/sti-360/app/admin", "destination": "/demos/sti-360/app/index.html" },
    { "source": "/demos/sti-360/app/student", "destination": "/demos/sti-360/app/index.html" },
    { "source": "/demos/sti-360/app/login", "destination": "/demos/sti-360/app/index.html" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
